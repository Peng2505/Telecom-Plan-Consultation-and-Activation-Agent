# 复制为 .env 后填写，不要把真实 Key 提交到 Git
LLM_TYPE=qwen
DASHSCOPE_API_KEY=sk-your-dashscope-key
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v2
EMBEDDING_DIMS=1536

CHROMADB_COLLECTION_NAME=policy_v2
KNOWLEDGE_MD=knowledge/data_plans_v2.md
# 旧粗库回滚：CHROMADB_COLLECTION_NAME=data_plans 且 KNOWLEDGE_MD=knowledge/data_plans.md
EVAL_CHROMA_COLLECTION=policy_v2
# 线上 retrieve_plans 与检索评测 Hit@K 共用
RETRIEVAL_TOP_K=4

DB_URI=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=disable
# Docker Compose 内 api 服务会覆盖为 @postgres 主机名，无需手改

# Gradio（本机直连 API 时默认 127.0.0.1；compose 内 web 服务会设为 http://api:8012）
API_BASE_URL=http://127.0.0.1:8012
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Docker 首次启动是否灌库：auto=集合不存在才灌；1=强制；0=跳过
RUN_INGEST=auto

# 可选：设置后，POST 接口需要 Authorization: Bearer <token>
APP_API_KEY=

# 可选：LangSmith 追踪（https://smith.langchain.com 申请 Key）
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=data-plan-agent

HOST=0.0.0.0
PORT=8012

BSS_STORE=output/bss_tickets.json

