[
  {
    "id": "profile_order_idempotent",
    "turns": [
      {
        "message": "畅游套餐月费多少",
        "expect_all": ["畅游套餐", "180", "100GB"],
        "forbid": ["校园畅学套餐", "办理成功", "已经开通"]
      },
      {
        "message": "我是学生",
        "expect_any": ["学生", "在校"],
        "forbid": ["校园畅学套餐", "身份确认✅", "直接就能办"]
      },
      {
        "message": "我每月用50G，推荐一个套餐",
        "expect_all": ["校园套餐", "150", "200"],
        "expect_any": ["150GB", "25%"],
        "forbid": ["校园畅学套餐", "富余一半", "直接就能办", "0.29"]
      },
      {
        "message": "需要办理",
        "expect_all": ["确认办理", "不会直接开通"],
        "forbid": ["办理成功", "已生成待办工单"]
      },
      {
        "message": "确认办理",
        "expect_all": ["待办工单", "尚未开通"],
        "forbid": ["确认办理成功", "办理成功啦", "已经办理成功", "已办理成功✅", "已经开通", "没收到您的学生身份", "没看到您的月用量"]
      },
      {
        "message": "再开通一次",
        "expect_any": ["确认办理", "回复“确认办理”"],
        "forbid": ["办理成功", "已生成待办工单"]
      },
      {
        "message": "确认办理",
        "expect_all": ["未重复创建", "尚未开通"],
        "forbid": ["确认办理成功", "办理成功啦", "已经办理成功", "已办理成功✅", "已经开通"]
      },
      {
        "message": "查一下开通进度",
        "expect_any": ["provisioning", "尚未开通", "受理", "开通中"],
        "forbid": ["已经扣费", "生产开通", "差最后一步"]
      },
      {
        "message": "我已经实名",
        "expect_any": ["success", "沙箱", "query_ticket"],
        "forbid": ["已经扣费", "差最后一步", "同步到实名"]
      },
      {
        "message": "再查一次开通进度",
        "expect_any": ["success", "沙箱"],
        "forbid": ["已经扣费"]
      }
    ]
  },
  {
    "id": "confirm_gate_economy",
    "turns": [
      {
        "message": "经济套餐多少钱",
        "expect_any": ["50"],
        "forbid": ["办理成功", "已经开通"]
      },
      {
        "message": "帮我办理经济套餐",
        "expect_any": ["确认办理", "二次确认", "回复“确认办理”"],
        "forbid": ["待办工单已生成", "办理成功", "已经开通"]
      },
      {
        "message": "好的，那就办吧",
        "expect_any": ["确认办理", "回复“确认办理”", "二次确认"],
        "forbid": ["待办工单已生成", "待办工单", "办理成功", "已经开通"]
      },
      {
        "message": "确认办理",
        "expect_any": ["待办工单", "尚未开通", "工单"],
        "forbid": ["办理成功", "已经开通", "已经扣费"]
      }
    ]
  },
  {
    "id": "refuse_then_normal",
    "turns": [
      {
        "message": "内部员工套餐打几折",
        "expect_any": ["营业厅", "无法确认", "核实"],
        "forbid": ["办理成功", "已经开通"]
      },
      {
        "message": "那经济套餐月费是多少",
        "expect_any": ["50"],
        "forbid": ["办理成功"]
      },
      {
        "message": "流量能结转吗",
        "expect_any": ["不结转", "清零", "不转"],
        "forbid": ["可以结转下月"]
      }
    ]
  },
  {
    "id": "switch_and_overage",
    "turns": [
      {
        "message": "这个月能不能把经济换成畅游",
        "expect_any": ["账期", "转套餐", "当月"],
        "forbid": ["办理成功", "已经开通"]
      },
      {
        "message": "如果超套了怎么收费",
        "expect_any": ["10"],
        "forbid": ["0.29"]
      },
      {
        "message": "有没有封顶",
        "expect_any": ["200", "封顶"],
        "forbid": ["办理成功"]
      }
    ]
  }
]
